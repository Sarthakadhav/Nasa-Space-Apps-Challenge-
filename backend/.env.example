# ORBITAL GUARD / ASTRA SENSE Flight Deck Backend Configuration
# -------------------------------------------------------------

# Environment: development / flight_simulation / mission_mode
ENVIRONMENT=flight_simulation
HOST=0.0.0.0
PORT=8000
DEBUG=True

# Google Gemini API Key (Optional for cloud explanations; 100% offline fallback provided)
GEMINI_API_KEY=

# Supabase (Optional cloud sync; local SQLite is the primary offline-first flight store)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Local SQLite Database file
DATABASE_URL=sqlite:///./orbital_guard.db

# Mission Elapsed Time & DSN Config
DSN_LATENCY_SECONDS=862
DEFAULT_MET_DAYS=142
